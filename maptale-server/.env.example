PORT=3001
NODE_ENV=development

# 数据库连接 (Supabase Postgres)
# 格式: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maptale?schema=public"

# Supabase 配置
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-key

# JWT 鉴权密钥
JWT_SECRET=maptale_super_secret_jwt_key_2026

# AI 模型配置 (国内首选模型)
# DeepSeek API (文本/推理/对话生成)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼 / 通义千问 DashScope (Qwen-VL 视觉多模态)
QWEN_API_KEY=your-aliyun-dashscope-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# 阿里云 OSS 图片对象存储
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=your-oss-access-key-secret
OSS_BUCKET=maptale-memories
OSS_CUSTOM_DOMAIN=

# 高德地图 Web 服务 Key (地理编码与逆地理编码)
AMAP_WEB_KEY=your-amap-web-key
